generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
}

enum PlayStatus {
  PLAYING
  COMPLETED
  ABANDONED
}

enum AttemptResult {
  CLEARED
  MISSED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole       @default(USER)
  totalPoints   Int            @default(0)
  accounts      Account[]
  sessions      Session[]
  plays         PlaySession[]
  pointLedger   PointLedger[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Word {
  id         String         @id @default(cuid())
  english    String         @unique
  difficulty Difficulty     @default(BEGINNER)
  fallSpeed  Int            @default(30)
  isActive   Boolean        @default(true)
  meanings   WordMeaning[]
  attempts   WordAttempt[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model WordMeaning {
  id        String   @id @default(cuid())
  wordId    String
  meaning   String
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([wordId, meaning])
  @@index([wordId])
}

model PlaySession {
  id           String        @id @default(cuid())
  userId       String
  status       PlayStatus    @default(PLAYING)
  clearedCount Int           @default(0)
  missedCount  Int           @default(0)
  startedAt    DateTime      @default(now())
  endedAt      DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts     WordAttempt[]

  @@index([userId, startedAt])
}

model WordAttempt {
  id              String        @id @default(cuid())
  playSessionId   String
  wordId          String
  shownMeaning    String
  result          AttemptResult
  spellingCorrect Boolean       @default(false)
  meaningCorrect  Boolean       @default(false)
  completedAt     DateTime      @default(now())
  playSession     PlaySession   @relation(fields: [playSessionId], references: [id], onDelete: Cascade)
  word            Word          @relation(fields: [wordId], references: [id])
  pointEntry      PointLedger?

  @@index([playSessionId])
  @@index([wordId])
}

model PointLedger {
  id        String      @id @default(cuid())
  userId    String
  attemptId String      @unique
  amount    Int
  reason    String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt   WordAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
